# Runtime
CODE_AS_SEARCH_DEFAULT_PROVIDER=openai
CODE_AS_SEARCH_DEFAULT_MODEL=
CODE_AS_SEARCH_TRACE_ENABLED=true
CODE_AS_SEARCH_DATABASE_URL=sqlite:///data/code_as_search.db
CODE_AS_SEARCH_SANDBOX_ROOT=.sandbox
CODE_AS_SEARCH_FIRECRAWL_URL=https://api.firecrawl.dev
CODE_AS_SEARCH_FIRECRAWL_TIMEOUT_SECONDS=30

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Claude / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Firecrawl is used for both search and page translation.
# Required for Firecrawl Cloud.
FIRECRAWL_API_KEY=
