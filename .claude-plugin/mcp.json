{
  "mcpServers": {
    "research": {
      "command": "${CLAUDE_PLUGIN_ROOT}/.venv/bin/python",
      "args": [
        "-m",
        "mcp_servers.firecrawl_server",
        "--profile",
        "director"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/servers"
      }
    },
    "reddit": {
      "command": "${CLAUDE_PLUGIN_ROOT}/.venv/bin/python",
      "args": [
        "-m",
        "mcp_servers.reddit_server"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/servers"
      }
    },
    "x": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/x/dist/mcp.js"
      ]
    },
    "xiaohongshu": {
      "type": "http",
      "url": "http://localhost:18060/mcp"
    }
  }
}
